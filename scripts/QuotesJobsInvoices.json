            "Bank Transfer",
            "Cheque",
            "Card"
          ]
        },
        {
          "field_name": "Reference",
          "data_type": "STRING",
          "required": false
        }
      ],
      "validation_rules": [
        {
          "rule_id": "RULE_PAY_AMOUNT_POSITIVE",
          "error_condition_expr": "Amount <= 0",
          "error_message": "Payment amount must be more than zero."
        }
      ],
      "view_mappings": {
        "detail": {
          "layoutType": "CommandCenter",
          "mainArea": {
